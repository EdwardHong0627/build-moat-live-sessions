# EMBED_MODEL=text-embedding-3-small
# DOCS_DIR=docs
# KB_DIR=.kb
# TOP_K=4
# SCORE_THRESHOLD=0.25
# CHUNK_MAX_CHARS=1000
# CHUNK_OVERLAP=150
# OPENAI_TIMEOUT=30
